# ─── FraudLens AI Frontend — Environment Configuration ──────────────────────
# Only VITE_* variables are exposed to the browser build.
# ⚠️  Never put API keys or secrets here — only PUBLIC configuration.

# Backend API URL (no trailing slash).
# Leave empty for local development (Vite dev server proxies /api to localhost).
# Set to your production backend URL for GitHub Pages / production builds.
# Example: VITE_API_BASE_URL=https://fraudlens-api.onrender.com
VITE_API_BASE_URL=

# Vite base path — only needed for GitHub Pages.
# Use "/" for user sites (username.github.io) or "/REPO_NAME/" for project sites.
# Example: VITE_BASE_PATH=/FraudLensAI/
VITE_BASE_PATH=
