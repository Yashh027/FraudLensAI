# ─── FraudLens AI — Environment Configuration ─────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# See README.md and DEPLOYMENT.md for full setup instructions.
# ⚠️  Never commit .env with real secrets to version control.

# === Database (Required) ===
# PostgreSQL (production recommended) or SQLite (local development only)
# Production: DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
# Local dev:  DATABASE_URL=sqlite:///./fraudlens.db
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/fraudlens

# === Threat Intelligence Providers ===
# Leave blank to disable a provider. The local URL analyzer always runs.
VIRUSTOTAL_API_KEY=
URLHAUS_API_KEY=
URLSCAN_API_KEY=

# === CORS (Required for production) ===
# Comma-separated list of frontend origins allowed to call the API.
# Development:  http://localhost:5173,http://127.0.0.1:5173
# Production:   https://YOUR_USERNAME.github.io (or your custom domain)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === Rate Limiting ===
# Shared distributed limiter: configure a Redis instance for multi-instance deployments.
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=16384

# === Logging ===
LOG_LEVEL=INFO

# === Authentication (Required) ===
# JWT secret key for signing tokens - generate a secure random string
# Example: openssl rand -hex 32
JWT_SECRET=
